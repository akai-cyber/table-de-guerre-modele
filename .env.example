# Le plus simple : lance "npm run setup", il écrit ce fichier pour toi.
# Sinon copie ce fichier en ".env" puis remplis-le. Ne le partage jamais (la clé API est personnelle).
# Garde les guillemets : sans eux, le # du tag serait pris pour un commentaire.
CLASH_API_TOKEN="colle-ta-cle-api-ici"
CLAN_TAG="#XXXXXXX"
CHEF_CODE="choisis-un-code-secret"
PORT=3000

# --- Facultatif ---
# Autre adresse d'API (par exemple un proxy) si l'IP de ton PC change souvent
# CLASH_API_BASE=https://api.clashofclans.com/v1
# Délai minimum entre deux appels à l'API Clash, en millisecondes (15000 par défaut)
# CACHE_MS=15000
# Fichier où sont sauvegardées les cibles (data.json par défaut)
# DATA_FILE=data.json
